# Copie para .env e preencha:
# cp .env.example .env

# Seu dominio (sem https, sem barra no final)
DOMAIN=pizzaralfs.com.br

# E-mail para certificado HTTPS automatico (Let's Encrypt)
ACME_EMAIL=seu-email@gmail.com

# Senha forte do PostgreSQL (invente uma longa)
DB_PASSWORD=troque_por_uma_senha_forte_aqui

# Login admin (somente no servidor — nao vai no JavaScript do site)
ADMIN_USER=admin
ADMIN_PASSWORD=troque_sua_senha_admin
# ADMIN_API_KEY=

# Garcom (auth na API — nao vai no build do site)
WAITER_USER=garcom
WAITER_PASSWORD=troque_sua_senha_garcom
# WAITER_API_KEY=

# POST /orders: pedidos por IP na janela (padrao 25 a cada 10 min)
# ORDER_RATE_LIMIT_MAX=25
# ORDER_RATE_LIMIT_WINDOW_MS=600000

# Release em /health: definido automaticamente no deploy (YYYYMMDD).
# Nao precisa colocar APP_RELEASE no .env — scripts usam a data do dia.
