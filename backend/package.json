{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de pedidos da Pizza Ralfs",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "db:init": "psql -U postgres -d pizzaralfs -f sql/init.sql",
    "db:migrate:delivery": "psql -U postgres -d pizzaralfs -f sql/migrate_orders_delivery.sql",
    "db:migrate:pricing": "psql -U postgres -d pizzaralfs -f sql/migrate_delivery_pricing.sql",
    "db:migrate:km-cep": "psql -U postgres -d pizzaralfs -f sql/migrate_delivery_km_cep.sql",
    "db:seed": "psql -U postgres -d pizzaralfs -f sql/seed.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  }
}
